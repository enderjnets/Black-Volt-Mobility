# ─── Black Volt Mobility — environment template ──────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# App
APP_ENV=development
DEBUG=true

# Database / Redis (defaults match docker-compose; override for prod)
POSTGRES_USER=blackvolt
POSTGRES_PASSWORD=blackvolt_local_pass
POSTGRES_DB=blackvolt
DATABASE_URL=postgresql+asyncpg://blackvolt:blackvolt_local_pass@db:5432/blackvolt
REDIS_URL=redis://redis:6379/0

# Frontend → backend wiring
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8000

# ─── LLM (Kimi primary + MiniMax fallback — NEVER Anthropic OAuth) ────────
LLM_PRIMARY=kimi
LLM_FALLBACK=minimax
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ─── Auth (Phase 1) ──────────────────────────────────────────────────────
AUTH_ENABLED=false
DASHBOARD_PASSWORD=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=

# ─── Integrations (added in later phases) ────────────────────────────────
# Google Maps Platform (Phase 2): Places + Directions + Distance Matrix.
# MAPS_SIMULATED=true (default) → deterministic stub routes, no billing needed.
# Set false + provide the key to go live. See docs/setup-google-maps.md.
MAPS_SIMULATED=true
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Square payments (Phase 3)
PAYMENTS_SIMULATED=true
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENV=sandbox
# Square Subscriptions (driver SaaS plans). Plan-variation ids from the Square
# dashboard. While PAYMENTS_SIMULATED=true a placeholder is fine — the real ids
# are generated later with the provisioning script.
SQUARE_PLAN_OPERATOR_MONTHLY=
SQUARE_PLAN_OPERATOR_ANNUAL=
# Square subscription webhooks: sync the local row as Square fires events. Both
# are created in the Square dashboard when you add the webhook subscription;
# SQUARE_WEBHOOK_URL must be the EXACT public URL registered there (the HMAC is
# computed over URL + body). Empty → the webhook endpoint returns 403.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
# Paid-plan gating (AI extract + public profile). Flip to true at billing launch;
# the default Black Volt tenant is always exempt.
ENTITLEMENTS_ENFORCED=false
# Abuse guard for the public subscribe endpoint (attempts/hour).
SUBSCRIBE_RATE_PER_EMAIL_HOURLY=5
SUBSCRIBE_RATE_PER_IP_HOURLY=30
# CORS allow-list (comma-separated). Default already includes the driver landing
# subdomain; override to restrict or extend per environment.
CORS_ORIGINS=http://localhost:3000,http://localhost:3005,https://driver.blackvoltmobility.com
# Google Calendar (scheduled rides) — service account shared on the BV calendar.
# CALENDAR_SIMULATED=true (default) → no-op; set false + provide the SA file + id.
CALENDAR_SIMULATED=true
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/gcal-sa.json
# OAuth owner token (authorized_user JSON) — required to INVITE attendees (a
# service account 403s on attendees). Generate with app/scripts/calendar_oauth_setup.py.
GOOGLE_OAUTH_TOKEN_FILE=
CALENDAR_TIMEZONE=America/Denver
# Pickup protocol: event block runs house→house from this dispatch base
# (deadhead to pickup + trip + return home + buffer). Empty → passenger trip only.
DISPATCH_ADDRESS=
# Comma-separated calendar invitees (dispatcher, driver), added as attendees.
CALENDAR_INVITEES=
# Turnaround buffer (minutes) added at the end of the house→house block.
CALENDAR_BLOCK_BUFFER_MIN=20
# Smart reservation (screenshot → fields). SMART_SIMULATED=true (default) →
# deterministic sample; set false + a key to go live.
# Provider: minimax_coding_vlm (Coding Plan sk-cp key → /v1/coding_plan/vlm) or
# minimax_anthropic (MiniMax-M3 pay-as-you-go sk-api key over /anthropic).
SMART_SIMULATED=true
SMART_VISION_PROVIDER=minimax_coding_vlm
SMART_VISION_API_KEY=
SMART_MAX_IMAGES=5
SMART_VISION_TIMEOUT=90
SMART_VISION_HOST=https://api.minimax.io
SMART_VISION_BASE_URL=https://api.minimax.io/anthropic
SMART_VISION_MODEL=MiniMax-M3
# Twilio SMS (Phase 7) — use a number DEDICATED to Black Volt (not Realtors')
SMS_SIMULATED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# VAPI AI calls (Phase 7)
VAPI_SIMULATED=true
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Flight tracking (Phase 8) — AeroAPI (FlightAware) or AviationStack
FLIGHTS_SIMULATED=true
FLIGHT_API_PROVIDER=aeroapi
FLIGHT_API_KEY=

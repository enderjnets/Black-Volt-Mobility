# ─── Black Volt Mobility — environment template ──────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# App
APP_ENV=development
DEBUG=true

# Database / Redis (defaults match docker-compose; override for prod)
POSTGRES_USER=blackvolt
POSTGRES_PASSWORD=blackvolt_local_pass
POSTGRES_DB=blackvolt
DATABASE_URL=postgresql+asyncpg://blackvolt:blackvolt_local_pass@db:5432/blackvolt
REDIS_URL=redis://redis:6379/0

# Frontend → backend wiring
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8000

# ─── LLM (Kimi primary + MiniMax fallback — NEVER Anthropic OAuth) ────────
LLM_PRIMARY=kimi
LLM_FALLBACK=minimax
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding
KIMI_MODEL=kimi-for-coding
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ─── Auth (Phase 1) ──────────────────────────────────────────────────────
AUTH_ENABLED=false
DASHBOARD_PASSWORD=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_ADMIN_EMAILS=

# ─── Integrations (added in later phases) ────────────────────────────────
# Google Maps Platform (Phase 2): Places + Directions + Distance Matrix.
# MAPS_SIMULATED=true (default) → deterministic stub routes, no billing needed.
# Set false + provide the key to go live. See docs/setup-google-maps.md.
MAPS_SIMULATED=true
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Square payments (Phase 3)
PAYMENTS_SIMULATED=true
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENV=sandbox
# Google Calendar (scheduled rides) — service account shared on the BV calendar.
# CALENDAR_SIMULATED=true (default) → no-op; set false + provide the SA file + id.
CALENDAR_SIMULATED=true
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/gcal-sa.json
CALENDAR_TIMEZONE=America/Denver
# Smart reservation (screenshot → fields). SMART_SIMULATED=true (default) →
# deterministic sample; set false + a key to go live.
# Provider: minimax_coding_vlm (Coding Plan sk-cp key → /v1/coding_plan/vlm) or
# minimax_anthropic (MiniMax-M3 pay-as-you-go sk-api key over /anthropic).
SMART_SIMULATED=true
SMART_VISION_PROVIDER=minimax_coding_vlm
SMART_VISION_API_KEY=
SMART_MAX_IMAGES=5
SMART_VISION_TIMEOUT=90
SMART_VISION_HOST=https://api.minimax.io
SMART_VISION_BASE_URL=https://api.minimax.io/anthropic
SMART_VISION_MODEL=MiniMax-M3
# Twilio SMS (Phase 7) — use a number DEDICATED to Black Volt (not Realtors')
SMS_SIMULATED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# VAPI AI calls (Phase 7)
VAPI_SIMULATED=true
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Flight tracking (Phase 8) — AeroAPI (FlightAware) or AviationStack
FLIGHTS_SIMULATED=true
FLIGHT_API_PROVIDER=aeroapi
FLIGHT_API_KEY=

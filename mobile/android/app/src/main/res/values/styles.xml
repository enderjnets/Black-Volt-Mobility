<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark, so the status bar / window chrome is
         #0A0A0F instead of the AppCompat.Light default that showed white. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/bv_void</item>
        <item name="android:navigationBarColor">@color/bv_void</item>
        <item name="android:windowBackground">@color/bv_void</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15 (API 35) enforces edge-to-edge and ignores statusBarColor
             unless we opt out; this lets the StatusBar plugin paint a solid dark
             bar. (On API 36 devices this is ignored; edge-to-edge handling TBD.) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bv_void</item>
        <item name="android:navigationBarColor">@color/bv_void</item>
        <item name="android:windowBackground">@color/bv_void</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/bv_void</item>
        <item name="android:statusBarColor">@color/bv_void</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
